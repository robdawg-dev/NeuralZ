# LR study, phase 2: held-constant runs - see LR_STUDY_PLAN.md.
# 3 LRs x 2 warmups, one seed each, all 7,000 steps: linear warmup from 1e-4 to the LR,
# then held there (--plateau-patience 1000 never cuts). Validation every 500 steps on
# 20,000 positions.
p2_lr0.8_w1000 AlphaGo.training.supervised_policy_trainer workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 500 --epochs 14 --validation-length 20000 --lr-schedule plateau --learning-rate 0.8 --warmup-steps 1000 --warmup-start-lr 0.0001 --plateau-patience 1000 --mixed-precision --seed 90001
p2_lr0.8_w4000 AlphaGo.training.supervised_policy_trainer workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 500 --epochs 14 --validation-length 20000 --lr-schedule plateau --learning-rate 0.8 --warmup-steps 4000 --warmup-start-lr 0.0001 --plateau-patience 1000 --mixed-precision --seed 90001
p2_lr1.6_w1000 AlphaGo.training.supervised_policy_trainer workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 500 --epochs 14 --validation-length 20000 --lr-schedule plateau --learning-rate 1.6 --warmup-steps 1000 --warmup-start-lr 0.0001 --plateau-patience 1000 --mixed-precision --seed 90001
p2_lr1.6_w4000 AlphaGo.training.supervised_policy_trainer workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 500 --epochs 14 --validation-length 20000 --lr-schedule plateau --learning-rate 1.6 --warmup-steps 4000 --warmup-start-lr 0.0001 --plateau-patience 1000 --mixed-precision --seed 90001
p2_lr3.2_w1000 AlphaGo.training.supervised_policy_trainer workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 500 --epochs 14 --validation-length 20000 --lr-schedule plateau --learning-rate 3.2 --warmup-steps 1000 --warmup-start-lr 0.0001 --plateau-patience 1000 --mixed-precision --seed 90001
