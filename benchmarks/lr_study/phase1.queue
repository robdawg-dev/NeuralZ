# LR study, phase 1: range tests at two ramp speeds, two seeds each - see LR_STUDY_PLAN.md.
# Warmup 1e-4 -> 1e-3 over 250 steps, then an exponential sweep 1e-3 -> 10 over 1,500
# (fast) or 4,500 (slow) steps. Validation every 250 steps on 10,240 positions.
p1_fast_s90001 AlphaGo.training.lr_range_test workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 250 --epochs 7 --validation-length 10240 --range-warmup-steps 250 --range-warmup-start-lr 1e-4 --range-floor-lr 1e-3 --range-ceiling-lr 10 --range-check-every 10 --mixed-precision --seed 90001
p1_fast_s90002 AlphaGo.training.lr_range_test workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 250 --epochs 7 --validation-length 10240 --range-warmup-steps 250 --range-warmup-start-lr 1e-4 --range-floor-lr 1e-3 --range-ceiling-lr 10 --range-check-every 10 --mixed-precision --seed 90002
p1_slow_s90001 AlphaGo.training.lr_range_test workspace/models/model_restower_b15c192_convnorm.json workspace/lr_study/shards {out} --minibatch 1024 --steps-per-epoch 250 --epochs 19 --validation-length 10240 --range-warmup-steps 250 --range-warmup-start-lr 1e-4 --range-floor-lr 1e-3 --range-ceiling-lr 10 --range-check-every 10 --mixed-precision --seed 90001
