[flake8]
max-line-length = 100
exclude = .git,.venv,build,deprecated,__pycache__,dist,older_scripts,workspace
# These set CUDA_VISIBLE_DEVICES before anything imports TensorFlow, so their imports
# deliberately come after code.
per-file-ignores =
    tests/test_bot_startup.py: E402
    tests/test_go_server_client.py: E402
    tests/test_joint_training.py: E402
    tests/test_lr_override.py: E402
    tests/test_make_model.py: E402
    tests/test_new_res_policy.py: E402
    tests/test_optimizer_state.py: E402
    tests/test_score_net_trainer.py: E402
    tests/test_shard_stream.py: E402
    tests/test_sibling_positions.py: E402
    tests/test_trainer_callbacks.py: E402
    tests/test_trainer_integration.py: E402
    tests/test_value_head_trainer.py: E402
    tests/test_value_model.py: E402
