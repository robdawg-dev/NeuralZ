*.pyc
*.npy
*.h5
*.sgf
*.pkl
src/
benchmarks/data/
/.idea
.venv/
# Machine-specific config (TRAINING_DATA_DIR etc. for docker-compose.yml) - see
# .env.example for what to set. Never commit the real one: it's a local path, not
# something meaningful on anyone else's machine.
.env
/tmpCythonVersion

# Generated by `python setup_cython.py build_ext --inplace` - rebuild, don't commit.
# .so/.cpp come from a Linux build (e.g. inside the project's Docker container),
# .pyd from a native Windows build - same rebuild-don't-commit rule either way.
/build/
AlphaGo/go/*.cpp
AlphaGo/go/*.so
AlphaGo/go/*.pyd
AlphaGo/preprocessing/preprocessing.cpp
AlphaGo/preprocessing/preprocessing.so
AlphaGo/preprocessing/preprocessing.*.so
AlphaGo/preprocessing/preprocessing.*.pyd
AlphaGo/tmp_data

# Scratch area for pipeline runs: manifests, keep-lists and shard sets produced by
# sgf_preparation / game_converter_katago_data. Regenerable from the source SGFs, and
# large (a manifest is ~46MB per 60k files; shards run to hundreds of GB).
workspace/
game_data/
# Local outputs: training runs (weights, metadata, optimizer state) and play-test
# models/games. Large and machine-specific.
benchmarks/_*/
play_tests/models/
play_tests/sgf/
