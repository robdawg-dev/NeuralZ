# Machine-specific config (TRAINING_DATA_DIR etc. for docker-compose.yml) - see
# .env.example for what to set. Never commit the real one: it's a local path, not
# something meaningful on anyone else's machine.
.env
/tmpCythonVersion

# Generated by `python setup_cython.py build_ext --inplace` - rebuild, don't commit.
# .so/.cpp come from a Linux build (e.g. inside the project's Docker container),
# .pyd from a native Windows build - same rebuild-don't-commit rule either way.
/build/
